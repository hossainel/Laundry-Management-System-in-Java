<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="710.0" prefWidth="1050.0" spacing="20" styleClass="main-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lms.laundry.controller.OrderListController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
        <Label styleClass="topbar-title" text="Orders" />
        <Button onAction="#addOrder" styleClass="btn-add" text="New POS Order" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="txtSearch" prefWidth="320" promptText="Search order, customer, status..." styleClass="search-field" />
        <Button onAction="#refreshTable" styleClass="btn-refresh" text="Refresh" />
    </HBox>
    <TableView fx:id="tblOrders" styleClass="directory-table" tableMenuButtonVisible="true" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60" text="ID" />
            <TableColumn fx:id="colCustomer" prefWidth="170" text="Customer" />
            <TableColumn fx:id="colOrderDate" prefWidth="170" text="Order Date" />
            <TableColumn fx:id="colDeliveryDate" prefWidth="130" text="Delivery" />
            <TableColumn fx:id="colStatus" prefWidth="120" text="Status" />
            <TableColumn fx:id="colTotal" prefWidth="110" text="Total" />
            <TableColumn fx:id="colPaid" prefWidth="110" text="Paid" />
            <TableColumn fx:id="colDue" prefWidth="110" text="Due" />
            <TableColumn fx:id="colPayment" prefWidth="90" sortable="false" text="Pay" />
            <TableColumn fx:id="colAction" prefWidth="160" sortable="false" text="Actions" />
        </columns>
        <placeholder>
            <Label styleClass="empty-table-placeholder" text="No orders found." />
        </placeholder>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label fx:id="lblStatus" styleClass="status-label" text="Showing 0 Orders" />
    </HBox>
    <stylesheets>
        <URL value="@../css/style.css" />
        <URL value="@../css/lists.css" />
    </stylesheets>
</VBox>
